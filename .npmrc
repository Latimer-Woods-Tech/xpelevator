legacy-peer-deps=true
# @latimer-woods-tech/* are published PUBLIC to registry.npmjs.org by
# Factory's publish.yml, which strips the GitHub-Packages publishConfig before
# publishing. This line used to point at npm.pkg.github.com, so any install of
# a shared package 401'd here — the scope was routed to a registry the packages
# were never published to. Matches Factory's own root .npmrc.
@latimer-woods-tech:registry=https://registry.npmjs.org/
